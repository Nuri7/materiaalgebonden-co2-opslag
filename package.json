    "README.md",
    "NOTICE"
  ],
  "keywords": [
    "csc",
    "biogenic-carbon",
    "epd",
    "en15804",
    "lca",
    "crcf"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuri7/materiaalgebonden-co2-opslag.git"
  }
