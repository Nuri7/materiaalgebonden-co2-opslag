  "description": "Open reference implementation of the Dutch determination method for material-bound CO2 storage (Construction Stored Carbon). Not affiliated with or endorsed by Stichting Climate Cleanup.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
